{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["./tsconfig.base.json", "./tsconfig.source.json"],
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "packages/*/tests/**/*.tsx",
    "scripts/**/*.mjs",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
