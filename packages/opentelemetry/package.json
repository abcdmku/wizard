{
  "name": "@openwizard/opentelemetry",
  "version": "0.1.0-next.0",
  "description": "OpenTelemetry instrumentation for OpenWizard FlowRun instances.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project opentelemetry",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@openwizard/core": "workspace:^",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@openwizard/core": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "keywords": [
    "wizard",
    "workflow",
    "opentelemetry",
    "observability",
    "tracing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdmku/wizard.git",
    "directory": "packages/opentelemetry"
  },
  "bugs": "https://github.com/abcdmku/wizard/issues",
  "homepage": "https://github.com/abcdmku/wizard#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
