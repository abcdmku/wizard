{
  "name": "@openwizard/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenWizard documentation site with guides, examples, API reference, and a browser playground.",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node ./scripts/postbuild.mjs",
    "build:typedoc": "typedoc",
    "check": "tsc --noEmit -p tsconfig.test.json && pnpm run check:snippets && node ./scripts/check-links.mjs && pnpm run build",
    "check:snippets": "vitest run --config vitest.config.ts",
    "check:links": "node ./scripts/check-links.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@openwizard/core": "workspace:*",
    "@openwizard/dev": "workspace:*",
    "@openwizard/devtools": "workspace:*",
    "@openwizard/drizzle": "workspace:*",
    "@openwizard/durable": "workspace:*",
    "@openwizard/effect": "workspace:*",
    "@openwizard/http": "workspace:*",
    "@openwizard/opentelemetry": "workspace:*",
    "@openwizard/react": "workspace:*",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-start": "^1.168.46",
    "lucide-react": "^1.32.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.32",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-orm": "0.45.2",
    "nitro": "3.0.260610-beta",
    "pagefind": "^1.5.2",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
