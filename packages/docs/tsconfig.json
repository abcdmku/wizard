{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "allowJs": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "lib", "scripts", "vite.config.ts"],
  "exclude": ["dist", "node_modules", ".output", ".tanstack"]
}
