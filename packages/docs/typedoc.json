{
  "$schema": "https://typedoc.org/schema.json",
  "name": "OpenWizard API",
  "entryPoints": [
    "typedoc/core.ts",
    "typedoc/core-inspect.ts",
    "typedoc/core-mirror.ts",
    "typedoc/core-testing.ts",
    "typedoc/durable.ts",
    "typedoc/durable-store.ts",
    "typedoc/durable-testing.ts",
    "typedoc/drizzle.ts",
    "typedoc/effect.ts",
    "typedoc/react.ts",
    "typedoc/devtools.ts",
    "typedoc/opentelemetry.ts",
    "typedoc/http.ts"
  ],
  "tsconfig": "tsconfig.typedoc.json",
  "out": "dist/typedoc",
  "readme": "none",
  "includeVersion": false,
  "hideGenerator": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "disableSources": true,
  "githubPages": false,
  "sort": ["kind", "alphabetical"],
  "navigation": { "includeCategories": false, "includeGroups": true, "includeFolders": false },
  "lightHighlightTheme": "github-light",
  "darkHighlightTheme": "github-dark",
  "titleLink": "../",
  "navigationLinks": {
    "Docs": "../",
    "GitHub": "https://github.com/abcdmku/wizard"
  },
  "validation": { "notExported": false, "invalidLink": false, "notDocumented": false },
  "treatWarningsAsErrors": false,
  "logLevel": "Warn"
}
