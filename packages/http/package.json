{
  "name": "@openwizard/http",
  "version": "0.1.0-next.1",
  "description": "A generated HTTP API, signed webhook receivers, outbound callbacks and a typed browser client for OpenWizard runs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./nitro": {
      "import": {
        "types": "./dist/nitro.d.ts",
        "default": "./dist/nitro.js"
      },
      "require": {
        "types": "./dist/nitro.d.cts",
        "default": "./dist/nitro.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "client": [
        "./dist/client.d.ts"
      ],
      "nitro": [
        "./dist/nitro.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project http",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "wizard",
    "workflow",
    "http",
    "rest-api",
    "openapi",
    "webhooks",
    "standard-webhooks",
    "server-sent-events",
    "oauth-scopes",
    "nitro",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdmku/wizard.git",
    "directory": "packages/http"
  },
  "bugs": "https://github.com/abcdmku/wizard/issues",
  "homepage": "https://github.com/abcdmku/wizard#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@openwizard/core": "workspace:^",
    "nitro": ">=3.0.0-beta"
  },
  "peerDependenciesMeta": {
    "nitro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openwizard/core": "workspace:*",
    "@openwizard/durable": "workspace:*",
    "@types/node": "^24.13.3",
    "nitro": "3.0.260610-beta",
    "zod": "^4.4.3"
  }
}
