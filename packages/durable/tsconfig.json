{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": [],
    // The entries import each other by package name (so each exists once in the build). Resolve
    // those self-imports to source so typechecking never reads a stale dist. Only the package's
    // own entries are mapped: the builds keep them external, and `@openwizard/core` still
    // resolves to its package.
    "paths": {
      "@openwizard/durable": ["./src/index.ts"],
      "@openwizard/durable/store": ["./src/store.ts"],
      "@openwizard/durable/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
