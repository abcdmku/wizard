{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": [],
    "paths": {
      "@openwizard/core": ["./src/index.ts"],
      "@openwizard/core/testing": ["./src/testing.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests/__canary__/**"]
}
