{
  "name": "@openwizard/drizzle",
  "version": "0.1.0-next.1",
  "description": "PostgreSQL and SQLite storage for durable OpenWizard runs, through Drizzle.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./pg": {
      "import": {
        "types": "./dist/pg.d.ts",
        "default": "./dist/pg.js"
      },
      "require": {
        "types": "./dist/pg.d.cts",
        "default": "./dist/pg.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "pg": [
        "./dist/pg.d.ts"
      ],
      "sqlite": [
        "./dist/sqlite.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project drizzle",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@openwizard/durable": "workspace:^",
    "drizzle-orm": ">=0.45.2 <1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@libsql/client": "^0.15.15",
    "@openwizard/durable": "workspace:*",
    "@openwizard/store-kit": "workspace:*",
    "@types/node": "^24.13.3",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "keywords": [
    "wizard",
    "workflow",
    "durable-execution",
    "drizzle",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdmku/wizard.git",
    "directory": "packages/drizzle"
  },
  "bugs": "https://github.com/abcdmku/wizard/issues",
  "homepage": "https://github.com/abcdmku/wizard#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
