{
  "name": "@openwizard/devtools",
  "version": "0.0.0",
  "description": "Devtools for OpenWizard — a React Flow + ELK graph of a flow with live status overlay, an event log, a step inspector and a replay timeline, in one dockable <Devtools> panel over a Wizard or a Mirror.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node ./scripts/build-css.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -w exec vitest run --project devtools",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "@openwizard/core": "workspace:^",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.12.0"
  },
  "devDependencies": {
    "@openwizard/core": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "keywords": [
    "wizard",
    "workflow",
    "devtools",
    "react",
    "react-flow",
    "graph",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdmku/wizard.git",
    "directory": "packages/devtools"
  },
  "bugs": "https://github.com/abcdmku/wizard/issues",
  "homepage": "https://github.com/abcdmku/wizard#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  }
}
