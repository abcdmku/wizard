{
  "name": "openwizard-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "TypeScript workflows that wait, retry, and resume.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abcdmku/wizard.git"
  },
  "bugs": "https://github.com/abcdmku/wizard/issues",
  "homepage": "https://github.com/abcdmku/wizard#readme",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"!@openwizard/docs\" run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/dx-audit/dx-audit.test.mjs",
    "test:canary": "node ./scripts/check-type-canary.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:api": "node ./scripts/check-api.mjs",
    "check:api:update": "node ./scripts/check-api.mjs --update",
    "check:docs": "node ./scripts/gen-export-tables.mjs --check && node ./scripts/check-doc-imports.mjs && node ./scripts/check-readme-quickstart.mjs README.md packages/core/AGENTS.md",
    "check:public-tags": "node ./scripts/check-public-tags.mjs",
    "check:pack": "node ./scripts/check-pack.mjs",
    "docs:gen": "node ./scripts/gen-export-tables.mjs",
    "docs:dev": "pnpm --filter @openwizard/docs dev",
    "docs:build": "pnpm --filter @openwizard/docs build",
    "dx:audit": "node ./scripts/dx-audit.mjs",
    "examples": "pnpm -r --filter \"./examples/*\" run check",
    "size": "size-limit",
    "publint": "pnpm -r --filter \"./packages/*\" --filter \"!@openwizard/docs\" --filter \"!@openwizard/store-kit\" exec publint",
    "attw": "pnpm -r --filter \"./packages/*\" --filter \"!@openwizard/docs\" --filter \"!@openwizard/store-kit\" exec attw --pack",
    "changeset": "changeset",
    "release:check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test && pnpm test:scripts && pnpm test:canary && pnpm publint && pnpm attw && pnpm size && pnpm check:api && pnpm check:docs && pnpm check:public-tags && pnpm examples && pnpm --filter @openwizard/docs check && pnpm check:pack",
    "release:publish": "changeset publish",
    "release": "pnpm release:check && pnpm release:publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@changesets/cli": "^3.0.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^24.13.3",
    "arktype": "^2.2.3",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "unrun": "^0.3.1",
    "valibot": "^1.4.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "size-limit": [
    {
      "name": "@openwizard/core (esm, brotli)",
      "path": "packages/core/dist/index.js",
      "limit": "55 kB",
      "brotli": true
    },
    {
      "name": "@openwizard/core/inspect (esm, brotli)",
      "path": "packages/core/dist/inspect.js",
      "limit": "14 kB",
      "brotli": true
    },
    {
      "name": "@openwizard/durable",
      "path": "packages/durable/dist/index.js",
      "limit": "7 kB",
      "brotli": true,
      "ignore": [
        "@openwizard/core"
      ]
    },
    {
      "name": "@openwizard/drizzle/pg",
      "path": "packages/drizzle/dist/pg.js",
      "limit": "10 kB",
      "brotli": true,
      "ignore": [
        "@openwizard/durable",
        "drizzle-orm",
        "drizzle-orm/*"
      ]
    },
    {
      "name": "@openwizard/drizzle/sqlite",
      "path": "packages/drizzle/dist/sqlite.js",
      "limit": "10 kB",
      "brotli": true,
      "ignore": [
        "@openwizard/durable",
        "drizzle-orm",
        "drizzle-orm/*"
      ]
    },
    {
      "name": "@openwizard/effect",
      "path": "packages/effect/dist/index.js",
      "limit": "2 kB",
      "brotli": true,
      "ignore": [
        "@openwizard/core",
        "@standard-schema/spec",
        "effect"
      ]
    },
    {
      "name": "@openwizard/react",
      "path": "packages/react/dist/index.js",
      "limit": "4 kB",
      "ignore": [
        "react",
        "react/jsx-runtime",
        "@openwizard/core"
      ]
    },
    {
      "name": "@openwizard/devtools",
      "path": "packages/devtools/dist/index.js",
      "limit": "60 kB",
      "brotli": true,
      "ignore": [
        "react",
        "react-dom",
        "react/jsx-runtime",
        "@openwizard/core",
        "@xyflow/react",
        "elkjs",
        "elkjs/*"
      ]
    },
    {
      "name": "@openwizard/opentelemetry",
      "path": "packages/opentelemetry/dist/index.js",
      "limit": "5 kB",
      "brotli": true,
      "ignore": [
        "@openwizard/core",
        "@opentelemetry/api"
      ]
    },
    {
      "name": "@openwizard/http",
      "path": "packages/http/dist/index.js",
      "limit": "22 kB",
      "brotli": true,
      "ignore": [
        "@openwizard/core",
        "@openwizard/core/inspect"
      ]
    },
    {
      "name": "@openwizard/http/client",
      "path": "packages/http/dist/client.js",
      "limit": "2 kB",
      "brotli": true
    },
    {
      "name": "@openwizard/http/nitro",
      "path": "packages/http/dist/nitro.js",
      "limit": "2.5 kB",
      "brotli": true,
      "ignore": [
        "nitro",
        "node:fs",
        "node:path",
        "node:url"
      ]
    }
  ]
}
