{
  "name": "@openwizard/fulfillment-lambdas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/payment.ts src/inventory.ts src/shipping.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --sourcemap --sources-content=false",
