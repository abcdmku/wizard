    "check": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@fulfillment/contracts": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
