{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@openwizard/core": ["../../packages/core/src/index.ts"],
      "@openwizard/core/testing": ["../../packages/core/src/testing.ts"],
      "@openwizard/core/inspect": ["../../packages/core/src/inspect/index.ts"],
      "@openwizard/core/mirror": ["../../packages/core/src/mirror/index.ts"],
      "@openwizard/durable": ["../../packages/durable/src/index.ts"],
      "@openwizard/durable/store": ["../../packages/durable/src/store.ts"],
      "@openwizard/durable/testing": ["../../packages/durable/src/testing.ts"],
      "@openwizard/drizzle": ["../../packages/drizzle/src/index.ts"],
      "@openwizard/drizzle/pg": ["../../packages/drizzle/src/pg.ts"],
      "@openwizard/drizzle/sqlite": ["../../packages/drizzle/src/sqlite.ts"],
      "@openwizard/react": ["../../packages/react/src/index.ts"],
      "@openwizard/devtools": ["../../packages/devtools/src/index.ts"],
      "@openwizard/effect": ["../../packages/effect/src/index.ts"],
      "@openwizard/opentelemetry": ["../../packages/opentelemetry/src/index.ts"],
      "@openwizard/http": ["../../packages/http/src/index.ts"],
      "@openwizard/http/client": ["../../packages/http/src/client.ts"],
      "@openwizard/http/nitro": ["../../packages/http/src/nitro.ts"],
      "@openwizard/fleet-shared": ["packages/shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest*.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "extends": ["../../tsconfig.base.json", "../../tsconfig.source.json"]
}
