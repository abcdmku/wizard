# Public listeners
FLEET_API_PORT=8787
FLEET_WEB_PORT=3000

# The API reads this URL in both local development and Compose.
DATABASE_URL=postgres://fleet:fleet@postgres:5432/fleet
FLEET_API_URL=http://127.0.0.1:8787
FLEET_WEB_URL=http://127.0.0.1:3000

# Seed and start order. The API runs migrations, then idempotent seed data, before listening.
FLEET_DISPATCH_TOKEN=fleet-demo-lakeshore
FLEET_SEED_ADMIN_TOKEN=fleet-demo-seed

# Integration fixture ids. Override these when a seed migration uses different ids.
FLEET_DELIVERY_ID=delivery-1
FLEET_SECONDARY_DELIVERY_ID=delivery-2
FLEET_INTERVENTION_BODY={"action":"hold","reason":"cold-chain drill","commandId":"cold-chain-drill-001"}

# Direct Vitest and Playwright invocations can use these flags. The package scripts set the
# appropriate flag themselves after `docker compose up --build`.
FLEET_INTEGRATION=0
FLEET_E2E=0
