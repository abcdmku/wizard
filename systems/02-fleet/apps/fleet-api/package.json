{
  "name": "@openwizard/fleet-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown src/main.ts src/seed.ts --format esm --out-dir dist",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.mjs",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config tests/vitest.config.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/sql-pg": "4.0.0-beta.107",
    "@openwizard/core": "workspace:*",
    "@openwizard/drizzle": "workspace:*",
    "@openwizard/durable": "workspace:*",
    "@openwizard/effect": "workspace:*",
    "@openwizard/fleet-shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.107",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@openwizard/core": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typescript": "~5.9.3",
    "vitest": "4.1.10"
  }
}
