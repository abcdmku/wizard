{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["../../tsconfig.base.json", "../../tsconfig.source.json"],
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "load/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
