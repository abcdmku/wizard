# Host ports. The API listens on 8080 inside Compose and the web server on 80.
DUNGEON_WEB_PORT=4400
DUNGEON_API_PORT=4410
DUNGEON_POSTGRES_PORT=5432

# PostgreSQL values are for local development only.
DUNGEON_DB_NAME=dungeon
DUNGEON_DB_USER=dungeon
DUNGEON_DB_PASSWORD=local-only

# Replace these before sharing a non-local environment.
DUNGEON_SESSION_SECRET=local-session-secret-change-me
DUNGEON_JWT_SECRET=local-jwt-secret-change-me
DUNGEON_SEED_KEY=local-seed-key
DUNGEON_CORS_ORIGIN=http://localhost:4400

# Browser WebSockets stay on the page origin through the nginx /ws proxy.
DUNGEON_BROWSER_API_URL=http://localhost:4410
DUNGEON_BROWSER_WS_URL=/ws
DUNGEON_WS_URL=ws://localhost:4410/ws
DUNGEON_LOAD_PROFILE=smoke

# Compose names keep reset commands scoped to this system.
DUNGEON_DB_VOLUME=openwizard-dungeon-postgres
DUNGEON_NETWORK_NAME=openwizard-dungeon
