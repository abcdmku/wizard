{
  "name": "@wizard/dungeon-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root .",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@openwizard/core": "workspace:*",
    "@openwizard/drizzle": "workspace:*",
    "@openwizard/durable": "workspace:*",
    "@wizard/dungeon-shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
